{
    "name": "jeffersongoncalves/laravel-us-privacy-opt-out",
    "description": "Opt-outs of sale, targeted advertising and profiling, and consent for sensitive data, under the US state privacy laws, with Global Privacy Control where each state requires it",
    "keywords": [
        "laravel",
        "privacy",
        "us-privacy",
        "opt-out",
        "global-privacy-control",
        "targeted-advertising"
    ],
    "homepage": "https://github.com/jeffersongoncalves/laravel-us-privacy-opt-out",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Jefferson Gonçalves",
            "email": "gerson.simao.92@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/validation": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "jeffersongoncalves/laravel-us-privacy": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "jeffersongoncalves/pest-plugin-database-migrations": "^1.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "JeffersonGoncalves\\UsPrivacyOptOut\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JeffersonGoncalves\\UsPrivacyOptOut\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@php ./vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "JeffersonGoncalves\\UsPrivacyOptOut\\UsPrivacyOptOutServiceProvider"
            ],
            "aliases": {
                "UsPrivacyOptOut": "JeffersonGoncalves\\UsPrivacyOptOut\\Facades\\UsPrivacyOptOut"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
